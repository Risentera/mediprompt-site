---
import { EMAIL } from '../contact';
---
<footer class="site-footer">
  <div class="container grid">
    <p class="copy">© Risentera. MediPrompt diterbitkan oleh Risentera.</p>
    <p>
      Mitra: <a href="https://plai.ac.id/" rel="noopener">Politeknik Artificial Intelligence Budi Mulia Dua (PLAI BMD)</a>
    </p>
    <p>Kontak: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--c-line); background: var(--c-bg-alt); color: var(--c-slate); font-size: var(--fs-sm); padding-block: var(--sp-12); }
  .grid { display: grid; gap: var(--sp-2); }
  .grid p { margin: 0; }
  .copy { color: var(--c-navy); font-weight: 600; }
</style>
